<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{#page}}
    <title>{{pageTitle}}</title>
    <meta name="description" content="{{metaDescription}}">

    <!--
      A search page is an internal result listing: useful to the visitor who ran it, thin and
      duplicative in an index. It is kept out with noindex rather than a robots.txt Disallow,
      because a disallowed URL is never fetched and the tag below would never be read.

      Only the landing page declares a canonical. It is what folds www and the raw Cloud Run
      hostname back into one URL. Pointing a noindex page at a different canonical would be two
      instructions that contradict each other, so the search pages declare none.
    -->
    {{#hasQuery}}
    <meta name="robots" content="noindex, follow">
    {{/hasQuery}}
    {{^hasQuery}}
    <link rel="canonical" href="https://ccmusicsearch.com/">
    {{/hasQuery}}

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="CCMusic Search">
    <meta property="og:title" content="{{pageTitle}}">
    <meta property="og:description" content="{{metaDescription}}">
    <!-- Declared only where it is the canonical URL. On a search page it would point the
         share card away from the search that was actually shared. -->
    {{^hasQuery}}
    <meta property="og:url" content="https://ccmusicsearch.com/">
    {{/hasQuery}}
    <meta name="twitter:card" content="summary">
    {{/page}}

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Requested here rather than @import-ed from styles.css: an @import is only discovered
         once that stylesheet has been fetched and parsed, which puts the fonts a whole round
         trip further back and leaves the preconnects above with nothing to warm up. -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap">
    <link rel="stylesheet" href="/ds/styles.css">
    <link rel="stylesheet" href="/css/search.css">

    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "CCMusic Search",
            "url": "https://ccmusicsearch.com/",
            "description": "A search engine for Creative Commons music, covering Jamendo, ccMixter, Internet Archive and Freesound.",
            "inLanguage": "en",
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": "https://ccmusicsearch.com/?q={search_term_string}"
                },
                "query-input": "required name=search_term_string"
            }
        }
    </script>
    <script>
        // Runs before first paint: a dark-theme reload must not flash the light ground.
        // Setting data-js here is also what reveals the controls that need scripting.
        (function () {
            var root = document.documentElement;
            root.setAttribute('data-js', 'on');
            var theme = 'light';
            try {
                theme = localStorage.getItem('ccmusic-theme')
                    || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            } catch (e) { /* private mode: stay light */ }
            root.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>
<!-- The external-link icon is drawn once per result row. Defining it here and referencing it
     with <use> keeps one copy in the document instead of one per row, which matters now that a
     search can return several hundred of them. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="icon-external" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4h6v6"></path>
        <path d="M20 4l-9 9"></path>
        <path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"></path>
    </symbol>
</svg>
{{#page}}
<!-- The attributes are what analytics.js reports; the browser decodes the entities Mustache
     writes, which a value built into a script block would not. -->
<div class="app"
     data-query="{{q}}"
     data-has-query="{{hasQuery}}"
     data-result-count="{{resultCount}}"
     data-source-count="{{sourceCount}}">

    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="/">
                <span class="brand-mark">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.75" stroke-linecap="round" aria-hidden="true">
                        <circle cx="7" cy="18" r="3"></circle>
                        <circle cx="18" cy="15" r="3"></circle>
                        <path d="M10 18V5l11-2v12"></path>
                    </svg>
                </span>
                <span class="brand-text">
                    <span class="brand-name">CCMusic Search</span>
                    <span class="brand-tagline">A search engine for Creative Commons music</span>
                </span>
            </a>

            <form class="searchbar" action="/" method="get" role="search">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.75" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M20 20l-3.5-3.5"></path>
                </svg>
                <input class="searchbar-input" type="search" id="q" name="q" value="{{q}}"
                       placeholder="Search Creative Commons music…" aria-label="Search Creative Commons music"
                       autocomplete="off" autocapitalize="none" spellcheck="false">
                <button class="btn btn-primary searchbar-submit" type="submit">Search</button>
            </form>

            <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch colour theme">
                <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"></path>
                </svg>
                <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v1M12 19v1M4 12h1M19 12h1M6.3 6.3l.7.7M17 17l.7.7M17.7 6.3l-.7.7M7 17l-.7.7M12 8a4 4 0 100 8 4 4 0 000-8z"></path>
                </svg>
            </button>
        </div>

        {{#hasResults}}
        <div class="chiprow" id="chiprow">
            <button class="chiprow-open" type="button" id="filters-open" aria-controls="filters" aria-expanded="false">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.75" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M7 12h10M10 17h4"></path>
                </svg>
                Filters<span id="filters-count"></span>
            </button>
        </div>
        {{/hasResults}}
    </header>

    {{#hasQuery}}
    <div class="workspace">

        <aside class="rail scroller" id="filters" data-open="false" aria-label="Filters">
            <div class="rail-head">
                <div class="rail-grabber"></div>
                <div class="rail-headrow">
                    <span class="rail-title">Filters</span>
                    <button class="rail-reset" type="button" data-reset>Reset</button>
                </div>
            </div>

            <div class="rail-scroll">
                {{#hasResults}}
                <div class="rail-filters">
                    <div class="rail-group">
                        <span class="rail-label" id="source-label">Source</span>
                        <div role="group" aria-labelledby="source-label">
                            {{#facets}}
                            <button class="facet" type="button" aria-pressed="false"
                                    data-facet="{{key}}" {{^enabled}}disabled{{/enabled}}>
                                <span class="facet-box"></span>
                                <span class="dot dot-{{key}}"></span>
                                <span class="facet-name">{{label}}</span>
                                <span class="facet-count">{{count}}</span>
                            </button>
                            {{/facets}}
                        </div>
                    </div>

                    <div class="rail-divider"></div>

                    <div class="rail-group">
                        <span class="rail-label">Licence</span>
                        <label class="switch">
                            <input type="checkbox" id="commercial-only">
                            <span class="switch-track"></span>
                            Commercial use OK
                        </label>
                        <div class="licences" role="group" aria-label="Licence">
                            {{#licences}}
                            <button class="tag tag-outline licence-chip" type="button" aria-pressed="false"
                                    data-licence="{{key}}">{{label}}</button>
                            {{/licences}}
                        </div>
                    </div>

                    {{#length.available}}
                    <div class="rail-divider"></div>

                    <div class="rail-group">
                        <div class="rail-rangehead">
                            <span class="rail-label">Length</span>
                            <output class="tabular" id="length-value">{{length.valueLabel}}</output>
                        </div>
                        <div class="range" data-range="length">
                            <span class="range-bound">{{length.floorLabel}}</span>
                            <span class="range-track">
                                <span class="range-fill"></span>
                                <input class="range-input" type="range" data-handle="lo" aria-label="Shortest length"
                                       min="{{length.floor}}" max="{{length.ceiling}}" step="15" value="{{length.floor}}">
                                <input class="range-input" type="range" data-handle="hi" aria-label="Longest length"
                                       min="{{length.floor}}" max="{{length.ceiling}}" step="15" value="{{length.ceiling}}">
                            </span>
                            <span class="range-bound range-bound-max">{{length.ceilingLabel}}</span>
                        </div>
                    </div>
                    {{/length.available}}

                    {{#tempo.available}}
                    <div class="rail-divider"></div>

                    <div class="rail-group">
                        <div class="rail-rangehead">
                            <span class="rail-label">Tempo</span>
                            <output class="tabular" id="tempo-value">{{tempo.valueLabel}}</output>
                        </div>
                        <div class="range" data-range="tempo">
                            <span class="range-bound">{{tempo.floorLabel}}</span>
                            <span class="range-track">
                                <span class="range-fill"></span>
                                <input class="range-input" type="range" data-handle="lo" aria-label="Slowest tempo"
                                       min="{{tempo.floor}}" max="{{tempo.ceiling}}" step="1" value="{{tempo.floor}}">
                                <input class="range-input" type="range" data-handle="hi" aria-label="Fastest tempo"
                                       min="{{tempo.floor}}" max="{{tempo.ceiling}}" step="1" value="{{tempo.ceiling}}">
                            </span>
                            <span class="range-bound range-bound-max">{{tempo.ceilingLabel}}</span>
                        </div>
                        <p class="rail-note">Only ccMixter reports BPM — tracks without one are kept.</p>
                    </div>
                    {{/tempo.available}}

                    <div class="rail-divider"></div>
                </div>
                {{/hasResults}}

                {{>about}}
            </div>

            <div class="sheet-foot">
                <button class="sheet-apply" type="button" data-close-sheet>Show
                    <span data-visible-count>{{resultCount}}</span>
                    <span data-result-noun>{{resultNoun}}</span></button>
            </div>
        </aside>

        <main class="results scroller">
            <!-- The count line below reads as the heading and is the live region, so it cannot
                 also be the h1. This gives the page the one heading it owes assistive tech
                 without a second visible title above the results. -->
            <h1 class="visually-hidden">Creative Commons music matching “{{q}}”</h1>

            <div class="results-head">
                <div class="results-summary">
                    <p class="results-count" id="results-count" aria-live="polite">
                        <strong data-visible-count>{{resultCount}}</strong>
                        <span data-result-noun>{{resultNoun}}</span> for “{{q}}” ·
                        <span data-visible-sources>{{sourceCount}}</span>
                        <span data-source-noun>{{sourceNoun}}</span>
                    </p>
                    {{#hasResults}}
                    <div class="sort" role="group" aria-label="Sort results">
                        <button class="sort-opt" type="button" aria-pressed="true" data-sort="relevance">Relevance</button>
                        <button class="sort-opt" type="button" aria-pressed="false" data-sort="newest">Newest</button>
                    </div>
                    {{/hasResults}}
                </div>

                {{#hasResults}}
                <div class="results-columns" aria-hidden="true">
                    <span></span>
                    <span>Track</span>
                    <span>Tags</span>
                    <span>Source</span>
                    <span>Licence</span>
                    <span>BPM · Len</span>
                    <span></span>
                </div>
                {{/hasResults}}
            </div>

            <ol class="rows" id="rows">
                {{#results}}
                <li class="row"
                    data-position="{{position}}"
                    data-service="{{serviceKey}}"
                    data-licence="{{licenceKey}}"
                    data-commercial="{{commercialUseAllowed}}"
                    data-duration="{{duration}}"
                    data-bpm="{{bpm}}"
                    data-date="{{dateIso}}">

                    <div class="row-disc">
                        <div class="disc"><span class="disc-label {{discClass}}"></span></div>
                    </div>

                    <div class="row-track">
                        <div class="row-title" title="{{title}}">{{title}}</div>
                        <div class="row-byline">
                            {{#hasAuthor}}
                            <span class="row-author">{{author}}</span>
                            <span aria-hidden="true">·</span>
                            {{/hasAuthor}}
                            <span class="row-date">{{dateLabel}}</span>
                        </div>
                    </div>

                    <div class="row-tags">
                        {{#tagList}}<span class="tag tag-neutral">{{.}}</span>{{/tagList}}
                    </div>

                    <div class="row-source">
                        <span class="chip-service">
                            <span class="dot dot-{{serviceKey}}"></span>{{serviceLabel}}<span
                                class="pop-inline"> · {{popularityLabel}}</span>
                        </span>
                        <div class="row-pop{{^hasPopularity}} row-pop-none{{/hasPopularity}}">{{popularityLabel}}</div>
                    </div>

                    <!-- display:contents on the desktop grid; a real flex row in the mobile card -->
                    <div class="row-foot">
                        <div class="row-licence">
                            <a class="chip-licence {{#commercialUseAllowed}}chip-licence-open{{/commercialUseAllowed}}{{^commercialUseAllowed}}chip-licence-restricted{{/commercialUseAllowed}}"
                               href="{{licenceUrl}}" target="_blank" rel="license noopener"
                               title="Read the {{licenceLabel}} licence">{{licenceLabel}}</a>
                        </div>

                        <div class="row-meta tabular">{{bpmLabel}} · {{durationLabel}}</div>

                        <a class="row-listen" href="{{externalLink}}" target="_blank" rel="noopener">
                            Listen
                            <svg width="14" height="14" aria-hidden="true"><use href="#icon-external"/></svg>
                        </a>
                    </div>
                </li>
                {{/results}}
            </ol>

            {{#hasResults}}
            <div class="load-more">
                <button class="btn btn-secondary" type="button" id="load-more" hidden>Load more results</button>
            </div>
            <div class="notice" id="no-matches" hidden>
                <h2>Nothing left after those filters</h2>
                <p>Every result was filtered out. Widen the ranges or clear a source to bring them back.</p>
                <p><button class="btn btn-secondary" type="button" data-reset>Reset filters</button></p>
            </div>
            {{/hasResults}}

            {{^hasResults}}
            <div class="notice">
                <h2>No music found</h2>
                <p>Nothing came back for “{{q}}”. Try a different word, an artist name, or a mood.</p>
            </div>
            {{/hasResults}}
        </main>
    </div>
    {{/hasQuery}}

    {{^hasQuery}}
    <main class="welcome">
        <div class="disc welcome-disc"><span class="disc-label disc-1"></span></div>
        <h1>Search free Creative Commons music</h1>
        <p class="welcome-lead">Search once, and get results from five catalogues at the same time — music you can
            use in videos, podcasts and streams, with every track's licence shown up front.</p>
        <div class="welcome-sources">
            {{#facets}}
            <span class="chip-service"><span class="dot dot-{{key}}"></span>{{label}}</span>
            {{/facets}}
        </div>
        {{>about}}
    </main>
    {{/hasQuery}}

</div>
{{/page}}

<!--
  Google tag (gtag.js). Loaded only on the real site: the measurement ID is public, but a
  local bootRun writing into the live property would skew the very numbers it reports.
  Set ccms-analytics-debug in localStorage to switch it on anywhere for testing.
-->
<script>
    (function () {
        var on = /(^|\.)ccmusicsearch\.com$/.test(location.hostname);
        try {
            on = on || !!localStorage.getItem('ccms-analytics-debug');
        } catch (e) { /* private mode: no override, just the hostname test */ }

        // analytics.js reads this, so it is set either way rather than left undefined on
        // the branch that does not load the tag.
        window.ccmsAnalytics = on;
        if (!on) return;

        var tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-C4SRXZE7P4';
        document.head.appendChild(tag);

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-C4SRXZE7P4');
    })();
</script>

<script src="/js/search.js" defer></script>
<script src="/js/analytics.js" defer></script>

</body>
</html>
